{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workline",
  "version": "0.1.0",
  "identifier": "com.daizl.workreport",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Workline",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http: https:; img-src 'self' asset: http: https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "work-report 快捷任务客户端",
    "longDescription": "从菜单栏快速查看、新建和推进 work-report 任务。",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
